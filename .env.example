# Copy to .env and .env.local for local development.
# Never put real passwords in Git.

NEXT_PUBLIC_APP_URL=http://127.0.0.1:45218

# SQLite file for local / first launch. On Hostinger you can later switch Prisma to MySQL.
DATABASE_URL="file:./dev.db"

# First administrator (created by prisma db seed). Change immediately.
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-strong-password"
ADMIN_BOOTSTRAP_NAME="Site Administrator"

# Property photos. On Hostinger keep this outside the deploy folder.
UPLOAD_DIR="./storage/uploads"

# Optional later
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Punjab Property Hub <no-reply@example.com>"
